# Example local config — copy to config.local.yaml and customize
# (config.local.yaml is gitignored)

# Big data disk
data_dir: data

# Where to find the InfiniTensor Python bindings
infinitensor_python_path: ../InfiniTensor/pyinfinitensor/src

# Size cap for collected models (bytes). Smaller = faster collection.
max_model_size_bytes: 83886080  # 80 MB

# Test backend
backend: cuda  # or cpu

# Use the bundled onnxruntime for correctness comparison
reference_runtime: onnxruntime

# Offline affects selected download sources, including external-data files.
network_enabled: false
